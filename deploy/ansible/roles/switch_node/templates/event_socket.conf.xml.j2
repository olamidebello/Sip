<configuration name="event_socket.conf" description="Local event socket">
  <settings>
    <param name="listen-ip" value="127.0.0.1"/>
    <param name="listen-port" value="8021"/>
    <param name="password" value="{{ freeswitch_esl_password | e }}"/>
    <param name="apply-inbound-acl" value="loopback.auto"/>
  </settings>
</configuration>
