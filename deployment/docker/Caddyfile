{$DOMAIN} {
  encode zstd gzip
  handle /ws {
    reverse_proxy {$SIP_WS_UPSTREAM:127.0.0.1:9}
  }
  @privacy path /privacy /privacy/
  handle @privacy {
    root * /srv
    rewrite * /privacy/index.html
    file_server
  }
  @terms path /terms /terms/
  handle @terms {
    root * /srv
    rewrite * /terms/index.html
    file_server
  }
  handle /api/* {
    reverse_proxy api:8080
  }
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
