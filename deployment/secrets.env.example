DOMAIN=sip.dobhrap.com
MYSQL_DATABASE=olamide
MYSQL_USER=olamide_app
MYSQL_PASSWORD=REPLACE_WITH_LONG_RANDOM_URL_SAFE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_RANDOM_PASSWORD
MYSQL_URL=mysql://olamide_app:REPLACE_WITH_LONG_RANDOM_URL_SAFE_PASSWORD@mysql:3306/olamide
MEETING_ICE_SERVERS_JSON=[]
# Optional TURN profile: generate a private 32+ character secret and set the
# same secret for API credentials and coturn. TURN_PUBLIC_IP must be the host's
# actual public IPv4 address. Open TCP/UDP 3478 and UDP 49160-49260.
TURN_SECRET=
TURN_PUBLIC_HOST=
TURN_PUBLIC_IP=
# Set COMPOSE_PROFILES=turn only after TURN_PUBLIC_IP, TURN_SECRET, DNS,
# and host firewall/security-group openings have been verified.
# COMPOSE_PROFILES=turn
# Optional: JSON map of tenant UUID to a randomly generated 32+ character
# HMAC secret for normalized CDR ingestion. Never commit a real key.
CDR_INGEST_KEYS_JSON={}
# Optional. Configure each tenant's LDAPS connection privately, then enable
# it and map group DNs from the administrator panel. Do not commit credentials.
LDAP_TENANTS_JSON={}
# Required for new self-service accounts. Configure a verified sender domain
# and a private random OTP HMAC secret of at least 32 characters.
RESEND_API_KEY=
RESEND_FROM=
OTP_HMAC_SECRET=
# Optional live switch provisioning adapter; HTTPS endpoint must acknowledge
# {"status":"active"} only after creating the SIP user on the switch.
SIP_CREDENTIAL_KEY=
SIP_PROVISION_URL=
SIP_PROVISION_TOKEN=
# Optional carrier adapter: must acknowledge activation after provisioning
# provider account and tenant trunk on the authoritative infrastructure.
CARRIER_PROVISION_URL=
CARRIER_PROVISION_TOKEN=

# Flowroute account callbacks. Generate with openssl rand -hex 32; keep private.
# For an existing installation, the next validated update generates this automatically.
FLOWROUTE_WEBHOOK_TOKEN=
# Optional: bind the Flowroute account to another tenant UUID (default tenant otherwise).
FLOWROUTE_WEBHOOK_TENANT_ID=

# Optional AI support assistant. Keep the key server-side.
OPENAI_SUPPORT_API_KEY=
OPENAI_SUPPORT_MODEL=gpt-4.1-mini
